# Backend Caddy for predatorhunters.co.uk — serves the pre-rendered SSG site on
# PLAIN HTTP :8090 and reverse-proxies /api/* to the Dioxus fullstack server.
#
# TLS is terminated by the shared EDGE Caddy (the research-site container, which
# owns :443 and holds the Let's Encrypt cert for the apex); it reverse-proxies
# the apex here over the host loopback (127.0.0.1:8090, not exposed to the
# network). So auto_https is OFF and there is no cert state here.
#
# This block owns the app's security headers (incl. the CSP). The edge passes
# these response headers through unchanged and adds HSTS for the TLS connection.

{
	admin off
	auto_https off
}

:8090 {
	encode zstd gzip

	# Liveness probe (the deploy + edge can check this).
	handle /healthz {
		respond "ok" 200
	}

	# Server functions (e.g. the SSG static-routes hook, future CMS/contact
	# endpoints) go to the fullstack server beside Caddy. If it is down this
	# 502s and the static site is unaffected.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Sitemap and RSS feed — pretty URLs that forward to the Dioxus server fns.
	# Both server fns use `input = GetUrl` so they accept plain GET requests.
	# The server fn prefix is /api and the endpoint names are sitemap_xml /
	# feed_xml, so the canonical paths are /api/sitemap_xml and /api/feed_xml.
	# `rewrite` replaces the request path before reverse-proxying, letting the
	# server fn handler see its registered path.  The Content-Type returned by
	# the server fn is `application/xml; charset=utf-8` (set by the custom Xml
	# codec inside feeds.rs), so no header manipulation is needed here.
	handle /sitemap.xml {
		rewrite * /api/sitemap_xml
		reverse_proxy 127.0.0.1:3000
	}

	handle /feed.xml {
		rewrite * /api/feed_xml
		reverse_proxy 127.0.0.1:3000
	}

	# Self-hosted images the crawler/promote pipeline downloads live on the
	# PERSISTENT /data volume (not the read-only SSG bundle). `handle_path` strips
	# the /uploads prefix and roots ONLY at /data/uploads, so the web root can
	# never reach the SQLite DB at /data/ph-press.db. Content-addressed names are
	# immutable, so cache them hard.
	handle_path /uploads/* {
		root * /data/uploads
		file_server
		header Cache-Control "public, max-age=604800, immutable"
	}

	# Everything else: pre-rendered per-route HTML (SSG), falling back to the SPA
	# shell. `{path}/index.html` serves the pre-rendered page for a route (e.g.
	# /news/slug → /news/slug/index.html); unknown paths hit /index.html and the
	# wasm router renders the 404 page.
	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server

		# Long-cache the immutable, content-hashed bundle assets + self-hosted
		# media (uploaded videos are content-addressed under /media)…
		@assets path *.wasm *.js *.css *.woff *.woff2 *.png *.jpg *.jpeg *.svg *.webp *.mp4 *.webm
		header @assets Cache-Control "public, max-age=604800"
		# …but never cache the HTML (so a redeploy is picked up immediately).
		@html not path *.wasm *.js *.css *.woff *.woff2 *.png *.jpg *.jpeg *.svg *.webp *.xml *.txt *.ico *.mp4 *.webm
		header @html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP. script-src needs 'unsafe-eval' because Dioxus-web's renderer
		# (sledgehammer_bindgen) builds its DOM-op function with `new Function`,
		# which CSP treats as eval — without it the wasm app fails to render after
		# hydration (client-side navigation silently breaks). 'unsafe-inline' is
		# for the first-party inline scripts (flash-free theme-init + the Dioxus
		# wasm-bootstrap blocks); 'wasm-unsafe-eval' for wasm compilation. Fonts
		# are self-hosted (/fonts/*.woff2 → font-src 'self'). Leaflet (the map) and
		# the ToastUI editor are ALSO self-hosted now (/vendor/* → covered by
		# script-src/style-src 'self'), so NO third-party CDN is allowed (unpkg
		# removed). frame-src allows the privacy-respecting youtube-nocookie player
		# on /watch; img-src keeps `https:` for editor-pasted article images + the
		# OpenStreetMap tile service. media-src 'self' blob: for self-hosted video.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: https://i.ytimg.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org; media-src 'self' blob:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
